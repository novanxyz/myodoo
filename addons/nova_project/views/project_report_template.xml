<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="report.paperformat" id="paperformat_project_report">
        <field name="name">paperformat.project.report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_width">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_right">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <template id="project_report_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="p">
            <t t-set="lang" t-value="p.partner_id.lang"/>

            <t t-call="web.external_layout" t-lang="lang">
                <div class="page">
                    <div class="oe_structure"/>
                    <t t-set="report_name">
                    <span>
                        <h3 class="text-center header bold">Project Report</h3>
                    </span>
                    </t>
                    <h2 class="text-center header bold"><strong><span t-esc="p.name"/></strong></h2>
                    <hr/>
                    <div class="row mt32 mb32">
                        <div class="col-auto mw-500 mb-3" style = "width : 25%">
                            <strong>Project Manager</strong>
                            <p class="m-0" t-esc="p.user_id.name"/>
                        </div>
                        <div class="col-auto mw-110 mb-3"  style = "width : 25%">
                            <strong>Client</strong>
                            <address t-field="p.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>

                        </div>
                    </div>
                    <div class="row project description">
                        <div t-raw="p.description"/>
                    </div>
                    
                    <t t-set="tasks" t-value="sorted(p.task_ids, key=lambda k: k['stage_id'].name + str(k['sequence']))"/>

                    <t t-foreach="tasks" t-as="task">
                    <div class= "row">
                        <div t-esc="task.name"/>
                        <div t-esc="task.user_id.name"/>
                        <div t-raw="task.description"/>
                        <div t-esc="task.date_deadline"/>
                        <hr/>
                    </div>
                    </t>
                </div>
                <div class="footer">
                    <div class="row text-center" style="border-top: 1px solid black;">
                        <div class="col-xs-3 col-xs-offset-9 text-right">
                            <ul class="list-inline" style="margin-top:10px;">
                                <li>Page: <span class="page"/></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </t>
    </template>

<record id="project_report_action" model="ir.actions.report">
    <field name="name">Project Report</field>
    <field name="model">project.project</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">nova_project.project_report_template</field>
    <field name="report_file">'%s Project Report' %(object.name)</field>
    <field name="print_report_name">'%s Project Report' %(object.name)</field>
    <field name="binding_model_id" ref="project.model_project_project"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="base.paperformat_euro"/>
</record>

</odoo>