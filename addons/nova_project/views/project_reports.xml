<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_print_project_report" model="ir.actions.report">
    <field name="name">Print Detailed Project Report</field>
    <field name="model">project.project</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_file">project_detail_report</field> 
    <field name="report_name">%s Project Report' %(object.name)</field> 
    <!-- <field name="paperformat" ref="report.paperformat_euro"/> -->
  </record>

  <record id="action_print_project_report_attachment" model="ir.actions.report">
    <field name="name">Print Detailed Project with Attachments</field>
    <field name="model">project.project</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_file">project_detail_report</field>
    <field name="report_name">project_detail_report</field>
    <field name="print_report_name">'%s Project Report' %(object.name)</field>
    <!-- <field name="paperformat" ref="report.paperformat_euro"/> -->
  </record>

</odoo>