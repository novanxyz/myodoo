<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="report.paperformat" id="base.paperformat_euro">
        <field name="name">A4</field>
        <field name="default">True</field>
        <field name="header_spacing">20</field>
        <field name="margin_top">30</field>
        <field name="margin_left">20</field>
        <field name="margin_right">15</field>
        <field name="margin_bottom">25</field>
        <field name="orientation">Portrait</field>
    </record>

    <record model="report.paperformat" id="a5_paper_portrait">
        <field name="name">A5 portrait</field>
        <field name="header_spacing">20</field>
        <field name="margin_top">30</field>
        <field name="margin_left">20</field>
        <field name="margin_right">15</field>
        <field name="margin_bottom">25</field>
        <field name="orientation">Portrait</field>
    </record>
    <record model="report.paperformat" id="a5_paper_landscape">
        <field name="name">A5 landscape</field>
        <field name="header_spacing">20</field>
        <field name="margin_top">30</field>
        <field name="margin_left">20</field>
        <field name="margin_right">15</field>
        <field name="margin_bottom">25</field>
        <field name="orientation">Landscape</field>
    </record>

    <record model="ir.actions.report" id="account.action_report_payment_receipt">
        <field name="paperformat_id" ref="nova_account.a5_paper_landscape"/>
    </record>

    <record id="action_report_proforma_invoice" model="ir.actions.report">
        <field name="name">Proforma Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nova_account.report_proforma_invoice</field>
        <field name="report_file">nova_account.report_proforma_invoice</field>

        <field name="print_report_name">'Proforma Invoice - %s' % (object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="attachment_use">False</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),
                (4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="action_report_signed_invoice" model="ir.actions.report">
        <field name="name">Signed Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nova_account.report_signed_invoice</field>
        <field name="report_file">nova_account.report_signed_invoice</field>

        <field name="print_report_name">'Invoice - %s' % (object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="attachment_use">False</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),
            (4, ref('account.group_account_readonly'))]"/>
    </record>

</odoo>