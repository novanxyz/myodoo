<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_address_layout">
        <div t-if="partner">
            <div>
                <span t-field="partner.name"/>
            </div>
            <div t-if="partner.street">
                <span t-field="partner.street"/><br/>
            </div>
            <div t-if="partner.street2">
                <span t-field="partner.street2"/><br/>
            </div>
            <div t-if="partner.city or partner.state_id or partner.zip">
                <span t-field="partner.city"/>
                <span t-if="partner.state_id">, <span t-field="partner.state_id.name"/></span>
                <span t-if="partner.zip">, <span t-field="partner.zip"/></span><br/>
            </div>
            <div t-if="partner.country_id">
                <span t-field="partner.country_id.name"/>
            </div>
        </div>
    </template>

    <template id="address_layout" inherit_id="web.address_layout">
        <xpath expr="//div[hasclass('address')]" position="attributes">
            <attribute name="style" add="max-width:100%; margin-left:unset !important"/>
        </xpath>
        <xpath expr="//div[@name='address']" position="replace">
            <div style="text-align: left; margin-bottom: 0;margin-top: 8px;">
                <p><strong>Kepada:</strong></p>
                <t t-call="nova_account.custom_address_layout">
                    <t t-set="partner" t-value="o.partner_id"/>
                </t>
            </div>
        </xpath>
    </template>

</odoo>
